# ============================================================================
# Drone Detector System - Environment Configuration Example
# ============================================================================
# Copy this file to .env and modify values for your environment
# Never commit .env to version control!

# ============================================================================
# Application Settings
# ============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Application Name
APP_NAME="Drone Detector System"

# Application Version (auto-detected from git tag)
APP_VERSION=

# Debug Mode (true/false)
DEBUG=true

# Secret Key for JWT and Sessions (generate with: openssl rand -base64 32)
SECRET_KEY=your-secret-key-here-change-in-production

# API Base URL
API_BASE_URL=http://localhost:8888

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG

# Timezone (IANA timezone)
TIMEZONE=UTC

# ============================================================================
# Database Settings
# ============================================================================

# PostgreSQL Database
DATABASE_URL=postgresql://drone_user:drone_password@localhost:5432/drone_detector
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# TimescaleDB (Time-series data)
TIMESCALE_URL=postgresql://analytics_user:analytics_password@localhost:5433/drone_analytics
TIMESCALE_POOL_SIZE=5

# SQLite (for development/testing - alternative to PostgreSQL)
# DATABASE_URL=sqlite:///./data/detections.db
# DATABASE_TYPE=sqlite

# ============================================================================
# Redis Settings (Cache & Message Broker)
# ============================================================================

# Redis URL
REDIS_URL=redis://:redis_password@localhost:6379/0

# Redis Password
REDIS_PASSWORD=redis_password

# Redis Host
REDIS_HOST=localhost

# Redis Port
REDIS_PORT=6379

# Redis Database Number
REDIS_DB=0

# Redis SSL (true/false)
REDIS_SSL=false

# ============================================================================
# MinIO / S3 Object Storage
# ============================================================================

# MinIO Endpoint
MINIO_ENDPOINT=localhost:9000

# MinIO Access Key
MINIO_ACCESS_KEY=minioadmin

# MinIO Secret Key
MINIO_SECRET_KEY=minioadmin123

# MinIO Use SSL (true/false)
MINIO_SECURE=false

# MinIO Buckets
MINIO_BUCKET_IQ=iq-recordings
MINIO_BUCKET_SPECTRUM=spectrum-data
MINIO_BUCKET_MODELS=ml-models
MINIO_BUCKET_EXPORTS=exports

# AWS S3 (alternative to MinIO)
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=drone-detector-data

# ============================================================================
# Hardware Settings
# ============================================================================

# Hardware Type (hackrf, rtl_sdr, pluto, mock, auto)
HARDWARE_TYPE=auto

# Use Mock Hardware (true/false) - for development without SDR
USE_MOCK_HARDWARE=false

# Sample Rate (Hz)
SAMPLE_RATE=2000000

# Center Frequency (Hz)
CENTER_FREQUENCY=2450000000

# RF Gain (dB)
GAIN=20

# LNA Gain (dB) - HackRF specific
LNA_GAIN=16

# VGA Gain (dB) - HackRF specific
VGA_GAIN=20

# Bandwidth (Hz)
BANDWIDTH=20000000

# Frequency Correction (PPM) - RTL-SDR specific
FREQUENCY_CORRECTION=0

# Bias Tee (true/false) - RTL-SDR specific
BIAS_TEE=false

# USB Device Index - for multiple SDRs
USB_DEVICE_INDEX=0

# ============================================================================
# Detection Settings
# ============================================================================

# Detection Threshold (dB above noise floor)
DETECTION_THRESHOLD=10

# Minimum Confidence Score (0-1)
MIN_CONFIDENCE=0.7

# Peak Detection Threshold (dB)
PEAK_THRESHOLD=10

# Minimum Peak Distance (bins)
MIN_PEAK_DISTANCE=10

# Peak Prominence (dB)
PEAK_PROMINENCE=3

# Update Interval (milliseconds)
UPDATE_INTERVAL_MS=100

# FFT Size (samples)
FFT_SIZE=1024

# FFT Window Type (hann, hamming, blackman, flattop)
FFT_WINDOW=hann

# Spectrogram Overlap (0-1)
SPECTROGRAM_OVERLAP=0.5

# ============================================================================
# ML Model Settings
# ============================================================================

# ML Model Path
MODEL_PATH=./models/classifier.pkl

# Feature Scaler Path
SCALER_PATH=./models/scaler.pkl

# Use GPU for ML inference (true/false)
USE_GPU=false

# ML Model Type (xgboost, random_forest, cnn, lstm)
ML_MODEL_TYPE=xgboost

# Model Confidence Threshold
ML_CONFIDENCE_THRESHOLD=0.7

# Enable Ensemble Models (true/false)
ML_ENSEMBLE=false

# ============================================================================
# Remote ID Settings
# ============================================================================

# Enable Remote ID scanning
REMOTE_ID_ENABLED=true

# Bluetooth Adapter (hci0, hci1, etc.)
BLUETOOTH_ADAPTER=hci0

# Wi-Fi Interface for Remote ID (monitor mode)
WIFI_INTERFACE=wlan0

# Remote ID Minimum RSSI (dBm)
REMOTE_ID_MIN_RSSI=-80

# Remote ID Cache Timeout (seconds)
REMOTE_ID_CACHE_TIMEOUT=10

# ============================================================================
# Alert Settings
# ============================================================================

# Enable Alerts
ALERTS_ENABLED=true

# Alert Severity Levels (comma-separated: critical,high,medium,low)
ALERT_SEVERITY_LEVELS=critical,high,medium,low

# Alert Cooldown (seconds)
ALERT_COOLDOWN_SECONDS=300

# Email Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@drone-detector.com
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
ALERT_EMAIL_RECIPIENTS=admin@example.com,security@example.com

# SMS Alerts (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_FROM_NUMBER=+1234567890
ALERT_SMS_NUMBERS=+0987654321

# Webhook Alerts
WEBHOOK_URL=https://your-webhook-endpoint.com/alert
WEBHOOK_SECRET=your-webhook-secret

# Slack Alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# PagerDuty Alerts
PAGERDUTY_INTEGRATION_KEY=your-pagerduty-key

# ============================================================================
# Recording Settings
# ============================================================================

# Enable IQ Recording
RECORDING_ENABLED=true

# Recording Duration (seconds)
RECORDING_DURATION=300

# Recording Format (complex_int16, complex_float32)
RECORDING_FORMAT=complex_int16

# Auto-stop recording after duration
RECORDING_AUTO_STOP=true

# Recording Compression (true/false)
RECORDING_COMPRESS=false

# Max Recording Size (MB)
RECORDING_MAX_SIZE_MB=1024

# Recording Retention Days
RECORDING_RETENTION_DAYS=30

# ============================================================================
# Data Retention Settings
# ============================================================================

# Detections Retention Days
DETECTIONS_RETENTION_DAYS=90

# Spectrum Data Retention Days
SPECTRUM_RETENTION_DAYS=7

# Logs Retention Days
LOGS_RETENTION_DAYS=30

# Exports Retention Days
EXPORTS_RETENTION_DAYS=7

# ============================================================================
# API Settings
# ============================================================================

# API Port
API_PORT=8888

# WebSocket Port
WEBSOCKET_PORT=8889

# Metrics Port
METRICS_PORT=9090

# API Workers (Gunicorn)
API_WORKERS=4

# API Threads per Worker
API_THREADS=2

# API Timeout (seconds)
API_TIMEOUT=120

# Rate Limiting (requests per minute)
RATE_LIMIT=100

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8888

# Enable API Documentation (true/false)
ENABLE_API_DOCS=true

# API Version
API_VERSION=v1

# ============================================================================
# Security Settings
# ============================================================================

# JWT Token Expiry (seconds)
JWT_EXPIRY_SECONDS=3600

# JWT Refresh Token Expiry (seconds)
JWT_REFRESH_EXPIRY_SECONDS=86400

# JWT Algorithm (HS256, RS256)
JWT_ALGORITHM=HS256

# Enable HTTPS (true/false)
ENABLE_HTTPS=false

# SSL Certificate Path
SSL_CERT_PATH=./certs/server.crt

# SSL Private Key Path
SSL_KEY_PATH=./certs/server.key

# Enable API Key Authentication
ENABLE_API_KEYS=true

# Enable MFA (Multi-factor Authentication)
ENABLE_MFA=false

# IP Whitelist (comma-separated CIDR ranges)
IP_WHITELIST=

# Rate Limiting per IP
RATE_LIMIT_PER_IP=100

# ============================================================================
# Monitoring & Observability
# ============================================================================

# Enable Prometheus Metrics
ENABLE_METRICS=true

# Enable Health Check Endpoint
ENABLE_HEALTH_CHECK=true

# Sentry DSN (for error tracking)
SENTRY_DSN=

# New Relic License Key
NEW_RELIC_LICENSE_KEY=

# New Relic App Name
NEW_RELIC_APP_NAME="Drone Detector"

# ============================================================================
# Development Settings
# ============================================================================

# Auto-reload on code changes (development only)
AUTO_RELOAD=true

# Enable Debug Toolbar
DEBUG_TOOLBAR=false

# Profile Code (for performance analysis)
PROFILE_CODE=false

# Enable SQL Query Logging
LOG_SQL_QUERIES=false

# Mock Data Path (for testing)
MOCK_DATA_PATH=./data/iq/mock

# Seed Database with Test Data
SEED_TEST_DATA=false

# ============================================================================
# External Services Integration
# ============================================================================

# FlightRadar24 Integration
FLIGHTRADAR24_API_KEY=
FLIGHTRADAR24_ENABLED=false

# ADS-B Exchange Integration
ADSB_EXCHANGE_API_KEY=
ADSB_EXCHANGE_ENABLED=false

# Weather API (for drone flight conditions)
WEATHER_API_KEY=
WEATHER_API_ENABLED=false

# Geocoding Service
GEOCODING_API_KEY=
GEOCODING_PROVIDER=openstreetmap

# ============================================================================
# Notification Services
# ============================================================================

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook
DISCORD_WEBHOOK_URL=

# Microsoft Teams Webhook
MS_TEAMS_WEBHOOK_URL=

# ============================================================================
# Advanced / Experimental Features
# ============================================================================

# Enable TDOA (Time Difference of Arrival) Localization
ENABLE_TDOA=false

# TDOA Reference Device ID
TDOA_REFERENCE_DEVICE=

# Enable Adaptive Gain Control
ENABLE_AGC=false

# Enable Frequency Hopping
ENABLE_HOPPING=false

# Hopping Frequencies (comma-separated Hz)
HOPPING_FREQUENCIES=2400000000,2450000000,5800000000

# Enable Automatic Drone Tracking
ENABLE_AUTO_TRACKING=false

# Enable AI-based Threat Prediction
ENABLE_THREAT_PREDICTION=false

# ============================================================================
# Performance Tuning
# ============================================================================

# IO Loop Threads
IO_LOOP_THREADS=4

# CPU Bound Task Workers
CPU_WORKERS=2

# Async Task Queue Max Size
TASK_QUEUE_MAX_SIZE=1000

# Database Connection Pool Size
DB_POOL_SIZE=10

# Cache TTL (seconds)
CACHE_TTL_SECONDS=60

# ============================================================================
# Backup & Recovery
# ============================================================================

# Backup Directory
BACKUP_DIR=./backups

# Backup Schedule (cron format)
BACKUP_SCHEDULE="0 2 * * *"

# Backup Retention Days
BACKUP_RETENTION_DAYS=30

# Enable Cloud Backup (true/false)
CLOUD_BACKUP_ENABLED=false

# Cloud Backup Provider (aws, gcp, azure)
CLOUD_BACKUP_PROVIDER=aws

# Cloud Backup Bucket
CLOUD_BACKUP_BUCKET=drone-detector-backups

# ============================================================================
# Compliance & Legal
# ============================================================================

# GDPR Compliance Mode
GDPR_COMPLIANT=false

# Data Anonymization Enabled
ANONYMIZE_DATA=false

# Audit Logging Enabled
AUDIT_LOGGING=true

# Legal Retention Period (days)
LEGAL_RETENTION_DAYS=365

# Display Legal Notice
DISPLAY_LEGAL_NOTICE=false

# ============================================================================
# Example Configuration Overrides by Environment
# ============================================================================

# Development overrides (uncomment in .env)
# ENVIRONMENT=development
# DEBUG=true
# LOG_LEVEL=DEBUG
# USE_MOCK_HARDWARE=true
# DATABASE_URL=sqlite:///./data/detections.db

# Production overrides (uncomment in .env)
# ENVIRONMENT=production
# DEBUG=false
# LOG_LEVEL=INFO
# USE_MOCK_HARDWARE=false
# SECRET_KEY=<generate-secure-key>
# DATABASE_URL=postgresql://user:password@prod-db-host:5432/drone_detector
# REDIS_URL=redis://:password@prod-redis-host:6379
# MINIO_ENDPOINT=minio.production.com:9000

# ============================================================================
# Helper Commands to Generate Secrets
# ============================================================================

# Generate SECRET_KEY:
# openssl rand -base64 32

# Generate PostgreSQL password:
# openssl rand -base64 24

# Generate Redis password:
# openssl rand -base64 24

# Generate API Key:
# openssl rand -base64 32

# Generate JWT Secret:
# openssl rand -base64 64

# ============================================================================
# Notes:
# ============================================================================
# 1. Never commit .env to version control
# 2. Keep .env.example updated when adding new variables
# 3. Use strong passwords in production
# 4. Regularly rotate secrets
# 5. Use different .env files per environment (.env.dev, .env.prod)
# 6. Consider using secret management tools (Vault, AWS Secrets Manager) in production