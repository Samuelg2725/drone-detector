#!/usr/bin/env python3
"""
Generate mock IQ data for DJI Mavic drone at 2.4 GHz

This script generates realistic synthetic IQ data that simulates
DJI OcuSync transmission characteristics for testing and development.
"""

import numpy as np
import struct
from pathlib import Path

# ============================================================================
# DJI Mavic Signal Parameters
# ============================================================================

class DJIMavicSignalGenerator:
    """Generate realistic DJI Mavic OcuSync signal"""
    
    def __init__(self):
        # DJI OcuSync parameters
        self.sample_rate = 10e6  # 10 MHz
        self.center_freq = 2.412e9  # 2.412 GHz (channel 1)
        self.bandwidth = 20e6  # 20 MHz
        self.modulation = "OFDM"
        self.subcarriers = 256
        self.cyclic_prefix = 64
        self.symbol_rate = 10e3  # symbols per second
        
        # Signal characteristics
        self.snr_db = 15  # Signal-to-noise ratio
        self.doppler_shift = 50  # Hz (simulating movement)
        self.frequency_hop = False
        
    def generate_ofdm_symbol(self, fft_size=256, cp_len=64):
        """Generate a single OFDM symbol"""
        # Generate random QPSK symbols for subcarriers
        data_symbols = (2 * np.random.randint(0, 2, fft_size) - 1) + \
                       1j * (2 * np.random.randint(0, 2, fft_size) - 1)
        data_symbols /= np.sqrt(2)  # Normalize power
        
        # IFFT to get time-domain signal
        ofdm_symbol = np.fft.ifft(data_symbols)
        
        # Add cyclic prefix
        cp = ofdm_symbol[-cp_len:]
        symbol_with_cp = np.concatenate([cp, ofdm_symbol])
        
        return symbol_with_cp
    
    def generate_signal(self, duration_seconds=10):
        """Generate complete signal for given duration"""
        num_samples = int(self.sample_rate * duration_seconds)
        
        # Calculate number of OFDM symbols needed
        symbol_len = self.subcarriers + self.cyclic_prefix
        num_symbols = int(np.ceil(num_samples / symbol_len))
        
        # Generate OFDM symbols
        signal = np.zeros(num_symbols * symbol_len, dtype=np.complex128)
        
        for i in range(num_symbols):
            symbol = self.generate_ofdm_symbol(self.subcarriers, self.cyclic_prefix)
            start = i * symbol_len
            signal[start:start + len(symbol)] = symbol
        
        # Trim to exact length
        signal = signal[:num_samples]
        
        # Apply Doppler shift (simulate moving drone)
        t = np.arange(num_samples) / self.sample_rate
        doppler = np.exp(1j * 2 * np.pi * self.doppler_shift * t)
        signal = signal * doppler
        
        # Add frequency hopping if enabled (simulate OcuSync)
        if self.frequency_hop:
            signal = self.apply_frequency_hopping(signal)
        
        # Normalize signal power
        signal = signal / np.sqrt(np.mean(np.abs(signal)**2))
        
        # Add noise
        noise_power = 10 ** (-self.snr_db / 10)
        noise = np.sqrt(noise_power/2) * (np.random.randn(num_samples) + 1j * np.random.randn(num_samples))
        signal = signal + noise
        
        return signal.astype(np.complex64)
    
    def apply_frequency_hopping(self, signal):
        """Simulate frequency hopping pattern (OcuSync)"""
        hop_pattern = [1, 3, 5, 7, 9, 11, 13, 15]
        hop_duration = int(self.sample_rate * 0.01)  # 10 ms per hop
        
        output = np.zeros_like(signal)
        num_hops = len(signal) // hop_duration
        
        for i in range(num_hops):
            hop_idx = i % len(hop_pattern)
            freq_shift = hop_pattern[hop_idx] * 1e6  # 1 MHz steps
            t = np.arange(hop_duration) / self.sample_rate
            hop_phase = np.exp(1j * 2 * np.pi * freq_shift * t)
            start = i * hop_duration
            output[start:start + hop_duration] = signal[start:start + hop_duration] * hop_phase
        
        output[num_hops * hop_duration:] = signal[num_hops * hop_duration:]
        return output


# ============================================================================
# Generate and Save IQ Data
# ============================================================================

def generate_dji_mavic_24g_file(duration_seconds=30, output_path=None):
    """
    Generate DJI Mavic 2.4 GHz IQ data file
    
    Args:
        duration_seconds: Duration of recording in seconds
        output_path: Output file path (uses default if None)
    """
    print("=" * 60)
    print("DJI Mavic 2.4 GHz IQ Data Generator")
    print("=" * 60)
    
    # Create generator
    generator = DJIMavicSignalGenerator()
    
    print(f"\nConfiguration:")
    print(f"  Sample Rate: {generator.sample_rate/1e6:.1f} MHz")
    print(f"  Center Frequency: {generator.center_freq/1e9:.3f} GHz")
    print(f"  Bandwidth: {generator.bandwidth/1e6:.1f} MHz")
    print(f"  Duration: {duration_seconds} seconds")
    print(f"  SNR: {generator.snr_db} dB")
    
    # Generate signal
    print("\nGenerating signal...")
    signal = generator.generate_signal(duration_seconds)
    
    print(f"  Samples generated: {len(signal):,}")
    print(f"  Data type: {signal.dtype}")
    
    # Set output path
    if output_path is None:
        output_path = Path("data/iq/mock/dji_mavic_2.4g.iq")
    
    output_path = Path(output_path)
    output_path.parent.mkdir(parents=True, exist_ok=True)
    
    # Save to file
    print(f"\nSaving to: {output_path}")
    signal.tofile(output_path)
    
    file_size = output_path.stat().st_size
    print(f"  File size: {file_size:,} bytes ({file_size / (1024**2):.2f} MB)")
    
    # Also save metadata
    metadata = {
        'drone_type': 'DJI Mavic 3',
        'frequency': generator.center_freq,
        'sample_rate': generator.sample_rate,
        'duration': duration_seconds,
        'num_samples': len(signal),
        'modulation': generator.modulation,
        'bandwidth': generator.bandwidth,
        'snr_db': generator.snr_db,
        'doppler_shift': generator.doppler_shift,
        'generated_by': 'DJIMavicSignalGenerator',
        'generation_date': __import__('datetime').datetime.now().isoformat()
    }
    
    metadata_path = output_path.with_suffix('.json')
    import json
    with open(metadata_path, 'w') as f:
        json.dump(metadata, f, indent=2)
    
    print(f"  Metadata saved to: {metadata_path}")
    
    # Print statistics
    print("\nSignal Statistics:")
    print(f"  Mean: {np.mean(signal):.4f}")
    print(f"  Std Dev: {np.std(signal):.4f}")
    print(f"  Max Magnitude: {np.max(np.abs(signal)):.4f}")
    print(f"  Mean Power: {10*np.log10(np.mean(np.abs(signal)**2)):.2f} dB")
    
    return signal


# ============================================================================
# Additional Mock Data Generators
# ============================================================================

def generate_noise_file(duration_seconds=30, output_path=None):
    """Generate noise-only IQ file for baseline"""
    print("\n" + "=" * 60)
    print("Noise Floor IQ Data Generator")
    print("=" * 60)
    
    sample_rate = 10e6
    num_samples = int(sample_rate * duration_seconds)
    
    # Generate Gaussian noise
    noise = (np.random.randn(num_samples) + 1j * np.random.randn(num_samples)).astype(np.complex64)
    noise = noise / np.sqrt(np.mean(np.abs(noise)**2)) * 0.1
    
    if output_path is None:
        output_path = Path("data/iq/mock/noise_floor.iq")
    
    output_path.parent.mkdir(parents=True, exist_ok=True)
    noise.tofile(output_path)
    
    print(f"Generated {duration_seconds}s of noise")
    print(f"Saved to: {output_path}")
    
    return noise


def generate_interference_file(duration_seconds=30, output_path=None):
    """Generate WiFi interference IQ file"""
    print("\n" + "=" * 60)
    print("WiFi Interference IQ Data Generator")
    print("=" * 60)
    
    sample_rate = 20e6
    num_samples = int(sample_rate * duration_seconds)
    
    # Simulate WiFi-like OFDM signal
    t = np.arange(num_samples) / sample_rate
    interference = np.exp(1j * 2 * np.pi * 1e6 * t)  # 1 MHz tone
    interference += 0.5 * np.exp(1j * 2 * np.pi * 2.5e6 * t)  # 2.5 MHz tone
    interference += 0.3 * (np.random.randn(num_samples) + 1j * np.random.randn(num_samples))
    
    interference = interference.astype(np.complex64)
    
    if output_path is None:
        output_path = Path("data/iq/mock/interference_wifi.iq")
    
    output_path.parent.mkdir(parents=True, exist_ok=True)
    interference.tofile(output_path)
    
    print(f"Generated {duration_seconds}s of WiFi interference")
    print(f"Saved to: {output_path}")
    
    return interference


# ============================================================================
# Main Function
# ============================================================================

def main():
    """Generate all mock IQ data files"""
    import argparse
    
    parser = argparse.ArgumentParser(description="Generate mock IQ data for testing")
    parser.add_argument("--duration", type=int, default=10, help="Duration in seconds")
    parser.add_argument("--output-dir", type=str, default="data/iq/mock", help="Output directory")
    parser.add_argument("--noise-only", action="store_true", help="Generate noise only")
    parser.add_argument("--interference", action="store_true", help="Generate interference")
    
    args = parser.parse_args()
    
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)
    
    if args.noise_only:
        generate_noise_file(args.duration, output_dir / "noise_floor.iq")
    elif args.interference:
        generate_interference_file(args.duration, output_dir / "interference_wifi.iq")
    else:
        # Generate DJI Mavic signal
        generate_dji_mavic_24g_file(
            duration_seconds=args.duration,
            output_path=output_dir / "dji_mavic_2.4g.iq"
        )
    
    print("\n" + "=" * 60)
    print("Mock data generation complete!")
    print("=" * 60)


if __name__ == "__main__":
    main()