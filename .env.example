# ============================================================================
# Drone Detector System - Environment Configuration Example
# ============================================================================
# Copy this file to .env and modify values for your environment
# Never commit .env to version control!

# ============================================================================
# Application Settings
# ============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Application Name
APP_NAME="Drone Detector System"

# Application Version (auto-detected from git tag)
APP_VERSION=

# Debug Mode (true/false)
DEBUG=true

# Secret Key for JWT and Sessions (generate with: openssl rand -base64 32)
SECRET_KEY=your-secret-key-here-change-in-production

# API Base URL
API_BASE_URL=http://localhost:8888

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG

# Timezone (IANA timezone)
TIMEZONE=UTC

# ============================================================================
# Database Settings
# ============================================================================

# PostgreSQL Database
DATABASE_URL=postgresql://drone_user:drone_password@postgres:5432/drone_detector
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# TimescaleDB (Time-series data)
TIMESCALE_URL=postgresql://analytics_user:analytics_password@timescaledb:5432/drone_analytics
TIMESCALE_POOL_SIZE=5

# SQLite (for development/testing - alternative to PostgreSQL)
# DATABASE_URL=sqlite:///./data/detections.db

# ============================================================================
# Redis Settings (Cache & Message Broker)
# ============================================================================

# Redis URL
REDIS_URL=redis://:redis_password@redis:6379/0

# Redis Password
REDIS_PASSWORD=redis_password

# Redis Host
REDIS_HOST=redis

# Redis Port
REDIS_PORT=6379

# Redis Database Number
REDIS_DB=0

# ============================================================================
# MinIO / S3 Object Storage
# ============================================================================

# MinIO Endpoint
MINIO_ENDPOINT=minio:9000

# MinIO Access Key
MINIO_ACCESS_KEY=minioadmin

# MinIO Secret Key
MINIO_SECRET_KEY=minioadmin123

# MinIO Use SSL (true/false)
MINIO_SECURE=false

# MinIO Buckets
MINIO_BUCKET_IQ=iq-recordings
MINIO_BUCKET_SPECTRUM=spectrum-data
MINIO_BUCKET_MODELS=ml-models
MINIO_BUCKET_EXPORTS=exports

# ============================================================================
# Hardware Settings
# ============================================================================

# Hardware Type (hackrf, rtl_sdr, pluto, mock, auto)
HARDWARE_TYPE=mock

# Use Mock Hardware (true/false) - for development without SDR
USE_MOCK_HARDWARE=true

# Sample Rate (Hz)
SAMPLE_RATE=2000000

# Center Frequency (Hz)
CENTER_FREQUENCY=2450000000

# RF Gain (dB)
GAIN=20

# LNA Gain (dB) - HackRF specific
LNA_GAIN=16

# VGA Gain (dB) - HackRF specific
VGA_GAIN=20

# Bandwidth (Hz)
BANDWIDTH=20000000

# ============================================================================
# Detection Settings
# ============================================================================

# Detection Threshold (dB above noise floor)
DETECTION_THRESHOLD=10

# Minimum Confidence Score (0-1)
MIN_CONFIDENCE=0.7

# Peak Detection Threshold (dB)
PEAK_THRESHOLD=10

# Minimum Peak Distance (bins)
MIN_PEAK_DISTANCE=10

# Peak Prominence (dB)
PEAK_PROMINENCE=3

# Update Interval (milliseconds)
UPDATE_INTERVAL_MS=100

# FFT Size (samples)
FFT_SIZE=1024

# FFT Window Type (hann, hamming, blackman)
FFT_WINDOW=hann

# ============================================================================
# API Settings
# ============================================================================

# API Port
API_PORT=8888

# WebSocket Port
WEBSOCKET_PORT=8889

# Metrics Port
METRICS_PORT=9090

# API Workers (Gunicorn)
API_WORKERS=4

# API Threads per Worker
API_THREADS=2

# API Timeout (seconds)
API_TIMEOUT=120

# Rate Limiting (requests per minute)
RATE_LIMIT=100

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8888

# Enable API Documentation (true/false)
ENABLE_API_DOCS=true

# ============================================================================
# Alert Settings
# ============================================================================

# Enable Alerts
ALERTS_ENABLED=true

# Alert Cooldown (seconds)
ALERT_COOLDOWN_SECONDS=300

# Email Alerts (if configured)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-password
# ALERT_EMAIL_RECIPIENTS=admin@example.com

# Slack Alerts (if configured)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ============================================================================
# Recording Settings
# ============================================================================

# Enable IQ Recording
RECORDING_ENABLED=true

# Recording Duration (seconds)
RECORDING_DURATION=300

# Recording Format (complex_int16, complex_float32)
RECORDING_FORMAT=complex_int16

# Recording Retention Days
RECORDING_RETENTION_DAYS=30

# ============================================================================
# ML Model Settings
# ============================================================================

# ML Model Path
MODEL_PATH=./models/classifier.pkl

# Use GPU for ML inference (true/false)
USE_GPU=false

# ML Model Type (xgboost, random_forest, cnn)
ML_MODEL_TYPE=xgboost

# Model Confidence Threshold
ML_CONFIDENCE_THRESHOLD=0.7

# ============================================================================
# Remote ID Settings
# ============================================================================

# Enable Remote ID scanning
REMOTE_ID_ENABLED=false

# Bluetooth Adapter (hci0, hci1, etc.)
BLUETOOTH_ADAPTER=hci0

# Remote ID Minimum RSSI (dBm)
REMOTE_ID_MIN_RSSI=-80

# ============================================================================
# Development Settings
# ============================================================================

# Auto-reload on code changes (development only)
AUTO_RELOAD=true

# Enable Debug Toolbar
DEBUG_TOOLBAR=false

# Profile Code (for performance analysis)
PROFILE_CODE=false

# Mock Data Path (for testing)
MOCK_DATA_PATH=./data/iq/mock

# ============================================================================
# Example Configuration with Docker Compose
# ============================================================================

# Database (when running with docker-compose)
# DATABASE_URL=postgresql://drone_user:drone_password@postgres:5432/drone_detector
# REDIS_URL=redis://:redis_password@redis:6379
# MINIO_ENDPOINT=minio:9000

# Database (when running locally)
# DATABASE_URL=postgresql://drone_user:drone_password@localhost:5432/drone_detector
# REDIS_URL=redis://:redis_password@localhost:6379
# MINIO_ENDPOINT=localhost:9000