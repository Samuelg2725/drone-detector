  "explanation": {
    "top_feature_descriptions": {
      "peak_magnitude": "Maximum power level in the spectrum. Higher values indicate stronger signals, characteristic of closer drones.",
      "signal_to_noise_ratio": "Ratio of signal power to noise floor. Critical for distinguishing actual drone signals from background noise.",
      "peak_freq": "Center frequency of the detected signal. Different drones operate on different frequency bands.",
      "bandwidth_6db": "Signal bandwidth measured at 6dB below peak. Varies significantly between drone types.",
      "spectral_flatness": "Measure of how flat the spectrum is. OFDM signals (DJI) have flatter spectra than FM signals (FPV).",
      "power_spectral_density_std": "Standard deviation of the power spectrum. Indicates signal stability and modulation type.",
      "cyclic_coherence": "Cyclostationary feature that captures periodicities in the signal. Strong for digital modulations.",
      "evm_rms": "Error Vector Magnitude - measures modulation quality. Lower EVM indicates cleaner signals.",
      "modulation_index": "Measure of modulation depth. Differentiates between analog (high index) and digital (low index) modulations.",
      "iq_variance": "Variance of IQ samples. Indicates signal activity and modulation complexity."
    }
  },

